# Load modular configuration
source ~/.config/zsh/exports.zsh

# Python Environment Initialization
command -v pyenv &>/dev/null && eval "$(pyenv init - zsh)"

# Zsh Plugin Manager Setup
source "${HOME}/.zgenom/zgenom.zsh"                   # Load zgenom plugin manager
zgenom autoupdate                                      # Auto-update plugins
if ! zgenom saved; then                               # If no saved configuration exists
  zgenom ohmyzsh                                       # Load Oh My Zsh framework
  zgenom ohmyzsh themes/agnoster                       # Load agnoster theme

  # plugins
  zgenom ohmyzsh plugins/git                           # git aliases and functions
  zgenom ohmyzsh plugins/extract                       # universal uncompressing `extract <file>`
  zgenom load jeffreytse/zsh-vi-mode                   # vim mode for command line editing

  zgenom save                                          # Save the configuration
fi

# Node.js Version Management Initialization
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"     # Load nvm if it exists
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # Load nvm bash completion

# Load custom configuration
source ~/.config/zsh/aliases.zsh
source ~/.config/zsh/functions.zsh

# fzf - Fuzzy Finder Integration
# Adds key bindings: Ctrl+R (history), Ctrl+T (files), Alt+C (cd)
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
if [ -d "$(brew --prefix 2>/dev/null)/opt/fzf/shell" ]; then
  source "$(brew --prefix)/opt/fzf/shell/completion.zsh"
  source "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
fi

if [[ -z "${CODEX_SHELL:-}" && -n "${ITERM_SESSION_ID:-}" && -r "${HOME}/.iterm2_shell_integration.zsh" ]]; then
  source "${HOME}/.iterm2_shell_integration.zsh"
fi

# zoxide - smarter cd command
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

export PATH="$HOME/.local/bin:$PATH"

# Use a compact prompt in Codex's embedded terminal. Agnoster's block colors are
# mapped through Codex's own ANSI palette and are difficult to read there.
if [[ -n "${CODEX_SHELL:-}" ]]; then
  autoload -Uz add-zsh-hook vcs_info
  setopt prompt_subst

  zstyle ':vcs_info:git:*' formats '%F{#a6e3a1}git:%b%f'
  zstyle ':vcs_info:git:*' actionformats '%F{#a6e3a1}git:%b|%a%f'

  codex_prompt_precmd() {
    vcs_info
  }
  add-zsh-hook precmd codex_prompt_precmd

  PROMPT='%F{#89b4fa}%~%f${vcs_info_msg_0_:+ ${vcs_info_msg_0_}} %F{#cba6f7}❯%f '
fi
